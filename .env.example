# Backend running on the same machine and network as OTP.
DATABASE_URL=sqlite:///./runtime/khanehsanj.sqlite3
DATA_DIR=./data
OTP_BASE_URL=http://127.0.0.1:8821
# Set only after discovery of the installed routing API.
OTP_API_PATH=/otp/transmodel/v3
OTP_API_TYPE=transmodel_v3
OTP_TIMEOUT_SECONDS=20
OTP_MAX_CONCURRENCY=3
OTP_MAX_RETRIES=1
OTP_GRAPH_VERSION=
OTP_SCHEDULE_BASIS=unknown
OTP_FIXTURE_MODE=false
# Docker Desktop: verify inside the backend container before enabling.
# OTP_BASE_URL=http://host.docker.internal:8821
ROUTING_BATCH_LIMIT=30
ROUTING_CACHE_TTL_SECONDS=3600
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
LLM_PROVIDER=avalai
LLM_ENABLED=false
INTENT_MODEL=gemini-3.6-flash
EXPLANATION_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash
IMPROVEMENT_MODEL=gemini-3.6-flash
AI_JUDGE_ENABLED=false
JUDGE_SAMPLE_RATE=0.10
JUDGE_DAILY_MAX_REQUESTS=100
LLM_DAILY_MAX_REQUESTS=20
LLM_MAX_OUTPUT_TOKENS=256
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
OTP_PROFILE_PATH=data/otp/api-profile.json
LLM_DAILY_MAX_RESERVED_TOKENS=30000
INTENT_VERSION=1
EXPLANATION_VERSION=1
JUDGE_VERSION=1
IMPROVEMENT_VERSION=1

# Phase 2: DATABASE_URL takes precedence over SQLITE_DB_PATH.
# SQLITE_DB_PATH=./runtime/khanehsanj.sqlite3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=homesanj_properties_v1
QDRANT_ENABLED=true
QDRANT_TIMEOUT_SECONDS=5
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_MODEL_VERSION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
EMBEDDING_MODEL_DIR=./runtime/models/multilingual-e5-small
EMBEDDING_CPU_THREADS=2
EMBEDDING_BATCH_SIZE=16
ADVANCED_VECTOR_CANDIDATES=100
ADVANCED_AI_ENABLED=false
ADVANCED_REASONING_MODEL=gemini-3.6-flash
INTENT_LLM_ENABLED=false
CLIENT_FILTERING_ENABLED=true
SEARCH_METRICS_ENABLED=true
MEASUREMENT_DEADLINE_SECONDS=120
REVIEW_API_TOKEN=

# Phase 3: opt-in internal evaluation; credentials stay on the backend.
QS_FEEDBACK_WINDOW_HOURS=24
REVIEWER_TOKENS_JSON={}
REVIEW_QUEUE_MAX=100
AI_IMPROVEMENT_ENABLED=false
JUDGE_MAX_OUTPUT_TOKENS=768
JUDGE_DAILY_MAX_RESERVED_TOKENS=30000
JUDGE_MAX_CALLS_PER_MINUTE=10
JUDGE_MAX_CONCURRENCY=1
# Optional hard cost ceiling requires a confirmed conservative account-specific rate.
JUDGE_DAILY_MAX_COST_USD=
JUDGE_UPPER_COST_PER_MILLION_TOKENS_USD=
IMPROVEMENT_MAX_OUTPUT_TOKENS=768
IMPROVEMENT_DAILY_MAX_REQUESTS=20
IMPROVEMENT_DAILY_MAX_RESERVED_TOKENS=15000
IMPROVEMENT_MAX_CALLS_PER_MINUTE=5
IMPROVEMENT_MAX_CONCURRENCY=1
IMPROVEMENT_DAILY_MAX_COST_USD=
IMPROVEMENT_UPPER_COST_PER_MILLION_TOKENS_USD=
